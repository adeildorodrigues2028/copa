      return PnlTemaClaro() ? C'254,226,226' : C'34,8,12';
   if(StringFind(status, "AGUARDA") >= 0 || StringFind(status, "FILA") >= 0)
      return PnlTemaClaro() ? C'254,243,199' : C'48,38,7';
